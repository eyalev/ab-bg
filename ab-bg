#!/usr/bin/env bash
# ab-bg — run agent-browser (>=0.34.0) against the shared authenticated Chrome
# (:9222) as a fully BACKGROUND agent, in the agent's OWN Chrome window.
#
# Stock agent-browser with --session + --pin-tab keeps concurrent agents from
# hijacking each other's tabs, but it only ever works inside the human's
# current window: `tab new` appends a tab to whatever window is in front and
# foregrounds it (Target.createTarget without background:true — upstream PR
# #1695 fixes the foregrounding, not the window choice). Two problems for the
# human: their working window flickers, and it fills up with agent tabs.
#
# This wrapper gives each agent session its own window instead:
#   Target.createTarget {newWindow:true, background:true}  -> new window, no
#   focus steal (verified on Linux/X11), then Browser.setWindowBounds
#   {windowState:"minimized"} so the agent's window never appears on screen or
#   in the way. agent-browser is then bound to that target id, and every later
#   command runs inside the agent's own hidden window.
#
# Reads, navigation, snapshot, screenshot, click and type all work against a
# minimized window (verified) — Chrome keeps rendering it off-screen.
#
# Usage:
#   ab-bg <session> spawn <url>            # create + pin a background tab in its OWN window
#   ab-bg <session> <agent-browser args…>  # any other command, pinned
#   ab-bg <session> cleanup                # close the agent's window + daemon
#   ab-bg <session> pick "<intent>" [--dry] [--min 0.8] [--max 80] [--danger 0.3] [--force]
#                                          # let a calibrated classifier choose WHICH
#                                          # interactive element matches the intent,
#                                          # then trusted-click it (see "pick" below)
#   ab-bg <session> run "<goal>" [--url U] [--dry] [--danger 0.3] [--force] [--max-steps 12]
#                                          # a whole task on this session's tab: the
#                                          # jev-ultrafast loop with pick's gate before
#                                          # every step (see "run" in the case below)
#
# pick — a bounded-choice step (the shape of Cua's jev-use, 2026-09-17):
#   1. `snapshot -i` gives the interactive elements with @refs — that is the
#      candidate table, and THIS SCRIPT owns it: only refs that are actually on
#      the page, plus a mandatory `abstain`, are ever offered.
#   2. TypeSafe's Jev (a System One model: no text generation, one Choice with
#      calibrated probabilities, ~300 ms) picks one candidate id for the intent.
#   3. An id not in the table fails closed (exit 4). `abstain`, or confidence
#      below --min, prints the top three and stops (exit 3) — nothing is clicked.
#   3b. pick-v2: the SAME call also asks a yes/no question about the INTENT AS A
#      WHOLE — would carrying it out delete, pay, send, publish or otherwise be
#      hard to undo? If that probability is >= --danger (0.3, deliberately low:
#      a wrong stop costs a re-run, a wrong click cannot be taken back) the step
#      stops with exit 5 whatever the element choice was, unless --force says a
#      person has decided. This exists because v1 hedged 0.65/0.35 on "delete
#      the API key": the menu button IS the right next step, and that is the
#      problem — the next step toward a destructive goal looks harmless.
#   4. Otherwise one trusted `click @ref` (real CDP input, so OAuth popups and
#      account choosers work), and the result is printed as JSON.
#   Text-only: canvas or image-only UIs have no refs and get `abstain`. Every
#   run is appended to ~/.cache/ab-bg/pick.jsonl with the question version, so
#   a bad pick can be read back. Key: ~/.config/desk/typesafe.key. Notes and
#   the cross-project journal: ~/.claude/docs/typesafe-jev.md.
#
# Examples:
#   ab-bg research-1 spawn https://news.ycombinator.com
#   ab-bg research-1 snapshot
#   ab-bg research-1 get text body
#   ab-bg research-1 cleanup
#
# Notes:
#   - Keep the same <session> on every call; the pin is sticky per session.
#   - User labels do NOT survive a daemon restart; the CDP targetId (from
#     `ab-bg <s> --json tab list`) is the only stable cross-restart ref.
#   - `tab list` shows tabs from ALL windows, including the human's. Don't
#     switch to one that isn't yours.
#   - Don't route a deliberate `bringtofront` through ab-bg — it would undo it.
#   - AB_BG_CDP_PORT overrides the CDP port (default 9222).
#   - AB_BG_OWN_WINDOW=0 falls back to the old same-window `tab new` behavior.
#   - AB_BG_SHOW_WINDOW=1 leaves the agent window visible (not minimized),
#     for when you want to watch the agent work.
set -uo pipefail

PORT="${AB_BG_CDP_PORT:-9222}"
OWN_WINDOW="${AB_BG_OWN_WINDOW:-1}"
SHOW_WINDOW="${AB_BG_SHOW_WINDOW:-0}"
SESSION="${1:?usage: ab-bg <session> <agent-browser args...>}"
shift
[[ $# -ge 1 ]] || { echo "usage: ab-bg <session> <agent-browser args...>" >&2; exit 2; }

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ab-bg"
SPARES="$STATE_DIR/spares.$SESSION"
mkdir -p "$STATE_DIR"

export DISPLAY="${DISPLAY:-:1}"
export XAUTHORITY="${XAUTHORITY:-/run/user/1000/gdm/Xauthority}"

front() {
  curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json" 2>/dev/null \
    | jq -r '[.[] | select(.type=="page")][0].id // empty'
}

blanks() {  # target ids of about:blank pages (daemon connect-time spares live here)
  curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json" 2>/dev/null \
    | jq -r '.[] | select(.type=="page" and .url=="about:blank") | .id' | sort
}

# Close about:blank targets that appeared since $1 (a sorted id list), recording
# them as this session's spares. The daemon can open its spare a beat after the
# command that started it returns, so poll for $2 seconds instead of looking
# exactly once. Returns 0 if anything was closed.
reap_spares() {
  local pre="$1" tries=$(( ${2:-3} * 4 )) id new closed=1
  while :; do
    new=$(comm -13 <(printf '%s\n' "$pre") <(blanks) 2>/dev/null)
    if [[ -n "$new" ]]; then
      printf '%s\n' "$new" >> "$SPARES"
      while read -r id; do
        [[ -n "$id" ]] || continue
        curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json/close/$id" >/dev/null 2>&1
        closed=0
      done <<< "$new"
    fi
    (( tries-- > 0 )) || break
    sleep 0.25
  done
  return $closed
}

# Re-select the tab that was in front before we touched the browser. The X-focus
# restore is not enough on its own: the spare is born in the user's front window,
# so closing it drops Chrome onto the tab beside it and the user is left on their
# last tab rather than the one they were reading.
restore_front() {
  local want="$1" now
  [[ -n "$want" ]] || return 0
  now=$(front)
  [[ -n "$now" && "$now" != "$want" ]] || return 0
  # only if the tab is still there to go back to
  curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json" 2>/dev/null \
    | jq -e --arg id "$want" 'any(.[]; .id == $id)' >/dev/null 2>&1 || return 0
  curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json/activate/$want" >/dev/null 2>&1
}

xfocus() { xdotool getactivewindow 2>/dev/null; }

ab() { agent-browser --cdp "$PORT" --session "$SESSION" "$@"; }

# Create a tab in a brand-new, non-focus-stealing, minimized window.
# Prints the target id, or nothing on failure.
new_bg_window() {
  local url="$1" minimize="$2"
  AB_URL="$url" AB_MIN="$minimize" AB_PORT="$PORT" python3 - <<'PY' 2>/dev/null
import json, os, sys, urllib.request
try:
    import websocket
except ImportError:
    sys.exit(1)
port = os.environ["AB_PORT"]
try:
    u = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=5))["webSocketDebuggerUrl"]
    ws = websocket.create_connection(u, timeout=10, suppress_origin=True)
except Exception:
    sys.exit(1)
def call(i, m, p):
    ws.send(json.dumps({"id": i, "method": m, "params": p}))
    while True:
        r = json.loads(ws.recv())
        if r.get("id") == i:
            if "error" in r: raise RuntimeError(r["error"])
            return r["result"]
try:
    tid = call(1, "Target.createTarget",
               {"url": os.environ["AB_URL"], "newWindow": True, "background": True})["targetId"]
    if os.environ["AB_MIN"] == "1":
        wid = call(2, "Browser.getWindowForTarget", {"targetId": tid})["windowId"]
        call(3, "Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "minimized"}})
    print(tid)
except Exception:
    sys.exit(1)
finally:
    ws.close()
PY
}

# Put the window holding $1 back down. Chrome ignores a minimize aimed at a
# window this young (setWindowBounds returns, the state reads back "normal"),
# and binding the session to the tab raises and maximizes it regardless -- so the
# minimize has to be re-applied after the bind, not only at creation.
minimize_target() {
  AB_TID="$1" AB_PORT="$PORT" python3 - <<'PY' 2>/dev/null
import json, os, sys, urllib.request
try:
    import websocket
except ImportError:
    sys.exit(1)
port = os.environ["AB_PORT"]
try:
    u = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=5))["webSocketDebuggerUrl"]
    ws = websocket.create_connection(u, timeout=10, suppress_origin=True)
except Exception:
    sys.exit(1)
def call(i, m, p):
    ws.send(json.dumps({"id": i, "method": m, "params": p}))
    while True:
        r = json.loads(ws.recv())
        if r.get("id") == i:
            if "error" in r: raise RuntimeError(r["error"])
            return r["result"]
try:
    wid = call(1, "Browser.getWindowForTarget", {"targetId": os.environ["AB_TID"]})["windowId"]
    call(2, "Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "minimized"}})
except Exception:
    sys.exit(1)
finally:
    ws.close()
PY
}

# Every verb needs this, but `pick`, `run` and `cleanup` exit inside the case and
# never reach the generic path below -- and any of them can be the command that
# restarts the daemon and so gets a spare parked in the human's window. Catch all
# of them on the way out. The trap restores only when it actually closed a spare:
# that is unambiguously our doing, so it can never fight a human who switched
# tabs mid-command. It is idempotent -- when the paths below already cleaned up,
# there is no spare left to find and the trap does nothing.
PRE_BLANKS=$(blanks)
FBEFORE=$(front)
settle() {
  local rc=$?
  reap_spares "$PRE_BLANKS" 0 && restore_front "$FBEFORE"
  return $rc
}
trap 'settle' EXIT

SPAWNING=0
case "$1" in
  spawn)
    URL="${2:?usage: ab-bg <session> spawn <url>}"
    SPAWNING=1
    XBEFORE=$(xfocus)

    TID=""
    if [[ "$OWN_WINDOW" == 1 ]]; then
      MIN=1; [[ "$SHOW_WINDOW" == 1 ]] && MIN=0
      TID=$(new_bg_window "$URL" "$MIN")
    fi

    if [[ -n "$TID" ]]; then
      # bind the session to the tab we just made in our own window
      ab --pin-tab tab "$TID" >/dev/null 2>&1
      STATUS=$?
      # the bind just raised and maximized our window -- put it back down
      [[ "$MIN" == 1 ]] && minimize_target "$TID"
      # The daemon's connect-time about:blank spare is born in whatever window
      # Chrome has in front — the user's — where it appends itself to the end of
      # the strip and takes the selection. Close it now rather than at cleanup.
      reap_spares "$PRE_BLANKS" 3
      # Closing it leaves Chrome on the neighbouring tab, so give the user back
      # the tab they were on before touching X focus.
      restore_front "$FBEFORE"
      # hand the X focus back if anything took it
      XAFTER=$(xfocus)
      if [[ -n "$XBEFORE" && -n "$XAFTER" && "$XBEFORE" != "$XAFTER" ]]; then
        xdotool windowactivate "$XBEFORE" >/dev/null 2>&1
      fi
      echo "$URL"
      echo "targetId=$TID"
      exit $STATUS
    fi

    # fallback: old same-window behavior
    [[ "$OWN_WINDOW" == 1 ]] && echo "ab-bg: own-window spawn unavailable, falling back to same-window tab" >&2
    set -- tab new --label "$SESSION" "$URL"
    ;;
  pick)
    INTENT="${2:?usage: ab-bg <session> pick \"<intent>\" [--dry] [--min 0.8] [--max 80] [--danger 0.3] [--force]}"
    shift 2
    DRY=0; MIN=0.8; MAX=80; DANGER=0.3; FORCE=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dry) DRY=1; shift ;;
        --min) MIN="${2:?--min needs a number}"; shift 2 ;;
        --max) MAX="${2:?--max needs a number}"; shift 2 ;;
        --danger) DANGER="${2:?--danger needs a number}"; shift 2 ;;
        --force) FORCE=1; shift ;;
        *) echo "ab-bg pick: unknown option $1" >&2; exit 2 ;;
      esac
    done
    KEY_FILE="$HOME/.config/desk/typesafe.key"
    [[ -r "$KEY_FILE" ]] || { echo "ab-bg pick: no key at $KEY_FILE — nothing was asked, nothing clicked" >&2; exit 2; }
    SNAP=$(ab --pin-tab --json snapshot -i 2>/dev/null) || { echo "ab-bg pick: snapshot failed" >&2; exit 1; }
    # The classifier step. Prints one JSON line; exit 0 = a candidate was chosen
    # with enough confidence, 3 = abstained / below --min, 4 = unknown id (fail
    # closed), 5 = the intent itself reads as destructive (>= --danger) and
    # --force was not given, 1 = provider or parse failure. The ref to click is
    # on stdout only when exit is 0 -- the shell below never clicks anything else.
    RESULT=$(AB_INTENT="$INTENT" AB_MIN="$MIN" AB_MAX="$MAX" AB_KEY_FILE="$KEY_FILE" AB_DRY="$DRY" \
      AB_DANGER="$DANGER" AB_FORCE="$FORCE" \
      AB_LOG="$STATE_DIR/pick.jsonl" AB_SESSION="$SESSION" python3 - "$SNAP" <<'PY'
import json, os, sys, time, urllib.request
QUESTION_VERSION = "pick-v2"
danger_min, force = float(os.environ["AB_DANGER"]), os.environ.get("AB_FORCE") == "1"
ACT = {"link","button","textbox","searchbox","checkbox","radio","combobox","menuitem",
       "menuitemcheckbox","menuitemradio","tab","switch","option","slider","spinbutton"}
snap = json.loads(sys.argv[1]).get("data", {})
refs = snap.get("refs", {}) or {}
intent, minc, maxn = os.environ["AB_INTENT"], float(os.environ["AB_MIN"]), int(os.environ["AB_MAX"])

def natural(k):  # e1, e2, ... e10 in DOM order, not lexicographic
    try: return int(k.lstrip("e"))
    except ValueError: return 10**9
cands = []
for k in sorted(refs, key=natural):
    r = refs[k]; role = r.get("role", ""); name = (r.get("name") or "").strip()
    if role not in ACT: continue
    if not name and role not in ("textbox", "searchbox", "combobox"): continue
    cands.append((k, role, name[:120] or "(unnamed input)"))
# Inputs and buttons first: the cap must not drop the one button under 79 links.
cands.sort(key=lambda c: (0 if c[1] != "link" else 1))
cands = cands[:maxn]
table = {k: f"{role}: {name}" for k, role, name in cands}
table["abstain"] = ("None of these clearly carries out the intent, or acting would be destructive, "
                    "irreversible or need a person's confirmation first.")
if len(table) == 1:
    out = {"intent": intent, "choice": "abstain", "confidence": 1.0, "reason": "no interactive elements", "acted": False}
    print(json.dumps(out)); sys.exit(3)

key = open(os.environ["AB_KEY_FILE"]).read().strip()
tree = (snap.get("snapshot") or "")
state = {"intent": intent, "page": snap.get("origin", ""),
         "interactive_elements": [f"{k} = {table[k]}" for k in table if k != "abstain"],
         "page_outline": tree[:6000]}
# Two questions, one call, same state, judged independently (that is how the API
# works). The Choice is about the NEXT STEP; the Noul is about the INTENT AS A
# WHOLE, because the next step toward a destructive goal usually looks harmless
# (opening the row menu before "Delete"). v1 asked the Choice to also refuse
# destructive actions and it hedged 0.65/0.35 instead; a separate yes/no with
# its own low bar is the honest shape.
body = {"state": state, "model": "jev-latest", "questions": {
    "pick": {
        "type": "choice",
        "instructions": ("Which ONE element should be acted on (clicked) to carry out the intent, "
                         "as the very next step? Prefer the element whose visible role and name match "
                         "the intent most directly. Choose abstain when nothing matches clearly or when "
                         "several match equally."),
        "criteria": table},
    "destructive": {
        "type": "noul",
        "instructions": ("Carrying out the INTENT as a whole -- not just this next click -- would "
                         "delete, remove, revoke, cancel, pay, purchase, transfer money, send a message "
                         "or email, publish or post publicly, change account security (password, "
                         "keys, 2FA), or otherwise do something hard to undo. Navigating, reading, "
                         "opening a menu or dialog, searching, filtering, logging in, or filling a "
                         "field without submitting is NOT this.")}}}
t0 = time.time()
try:
    req = urllib.request.Request("https://api.typesafe.ai/v1/systemone", data=json.dumps(body).encode(),
                                 headers={"content-type": "application/json", "authorization": f"Bearer {key}"})
    answers = json.load(urllib.request.urlopen(req, timeout=30))["answers"]
    ans, danger = answers["pick"], float(answers["destructive"]["noul"])
except Exception as e:
    print(json.dumps({"intent": intent, "error": str(e)[:200], "acted": False})); sys.exit(1)
ms = int((time.time() - t0) * 1000)
choice, conf, probs = ans.get("choice"), float(ans.get("confidence", 0)), ans.get("probabilities", {}) or {}
top = sorted(probs.items(), key=lambda kv: -kv[1])[:3]
out = {"intent": intent, "choice": choice, "confidence": round(conf, 3), "destructive": round(danger, 3),
       "top3": [{"id": k, "p": round(p, 3), "what": table.get(k, "?")} for k, p in top],
       "candidates": len(table) - 1, "ms": ms, "question": QUESTION_VERSION, "acted": False}
if choice not in table:                       # fail closed
    out["error"] = "provider returned an id not in the candidate table"; code = 4
elif danger >= danger_min and not force:      # the intent, not the element
    out["stopped"] = f"destructive intent {danger:.2f} >= {danger_min}; re-run with --force if a person has decided"; code = 5
    if choice != "abstain": out["would_have"] = table[choice]
elif choice == "abstain" or conf < minc:
    out["stopped"] = "abstain" if choice == "abstain" else f"confidence {conf:.2f} < {minc}"; code = 3
else:
    out["ref"], out["what"] = choice, table[choice]; code = 0
    if force and danger >= danger_min: out["forced"] = True
try:
    os.makedirs(os.path.dirname(os.environ["AB_LOG"]), exist_ok=True)
    with open(os.environ["AB_LOG"], "a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "session": os.environ["AB_SESSION"],
                            "page": state["page"], **out, "dry": os.environ.get("AB_DRY") == "1"}) + "\n")
except Exception:
    pass
print(json.dumps(out)); sys.exit(code)
PY
    )
    PSTATUS=$?
    if [[ $PSTATUS -ne 0 || "$DRY" == 1 ]]; then
      echo "$RESULT"
      exit $PSTATUS
    fi
    REF=$(jq -r '.ref // empty' <<<"$RESULT")
    [[ -n "$REF" ]] || { echo "$RESULT"; exit 4; }
    if ab --pin-tab click "@$REF" >/dev/null 2>&1; then
      jq -c '.acted = true' <<<"$RESULT"
      exit 0
    fi
    jq -c '.acted = false | .error = "click failed"' <<<"$RESULT"
    exit 1
    ;;
  run)
    # A whole task, not one click: browser-use/jev-ultrafast's loop (look → Jev picks
    # operation + element → act → repeat, a small LLM typing when a field needs text)
    # on THIS session's hidden tab, with pick's destructive gate in front of every
    # step (examples/jev-ultrafast-gated.py in the ab-bg repo). The goal is judged
    # once before anything is chosen and every step before it runs; at or above
    # --danger (0.3) the run stops with exit 5 and says what it would have done;
    # --force records that a person decided. --dry judges the goal and predicts the
    # first step only. Exit 0 = done, 3 = blocked / gave up, 5 = gated.
    #
    # Needs the jev-ultrafast checkout (AB_BG_ULTRAFAST_DIR, default
    # ~/projects/github/browser-use/jev-ultrafast, `uv sync` once) and
    # ~/.config/desk/typesafe.key; text is written by xAI's grok-4.5 unless
    # TEXT_MODEL_API_KEY / TEXT_MODEL_BASE_URL / TEXT_MODEL are set.
    GOAL="${2:?usage: ab-bg <session> run \"<goal>\" [--url <url>] [--dry] [--danger 0.3] [--force] [--max-steps 12]}"
    shift 2
    UF="${AB_BG_ULTRAFAST_DIR:-$HOME/projects/github/browser-use/jev-ultrafast}"
    GATED="$HOME/projects/personal/2026-09/ab-bg/examples/jev-ultrafast-gated.py"
    [[ -f "$UF/pyproject.toml" ]] || { echo "ab-bg run: no jev-ultrafast checkout at $UF — git clone https://github.com/browser-use/jev-ultrafast.git \"$UF\" && (cd \"$UF\" && uv sync)" >&2; exit 2; }
    [[ -f "$GATED" ]] || { echo "ab-bg run: missing $GATED" >&2; exit 2; }
    [[ -r "$HOME/.config/desk/typesafe.key" ]] || { echo "ab-bg run: no key at ~/.config/desk/typesafe.key" >&2; exit 2; }
    TID=$(ab --pin-tab --json tab list 2>/dev/null | jq -r '.data.tabs[]? | select(.active) | .targetId // empty' | head -1)
    [[ -n "$TID" ]] || { echo "ab-bg run: this session has no tab — spawn one first" >&2; exit 2; }
    export BU_CDP_URL="http://127.0.0.1:$PORT"
    export TYPESAFE_API_KEY; TYPESAFE_API_KEY=$(cat "$HOME/.config/desk/typesafe.key")
    if [[ -z "${TEXT_MODEL_API_KEY:-}" && -r "$HOME/.config/desk/xai.key" ]]; then
      export TEXT_MODEL_API_KEY; TEXT_MODEL_API_KEY=$(cat "$HOME/.config/desk/xai.key")
      export TEXT_MODEL_BASE_URL="${TEXT_MODEL_BASE_URL:-https://api.x.ai/v1}" TEXT_MODEL="${TEXT_MODEL:-grok-4.5}" TEXT_MODEL_REASONING="${TEXT_MODEL_REASONING:-none}"
    fi
    (cd "$UF" && exec uv run --quiet python "$GATED" --target "$TID" --goal "$GOAL" "$@")
    exit $?
    ;;
  cleanup)
    ab --pin-tab tab close >/dev/null 2>&1
    ab close >/dev/null 2>&1
    # close the daemon's connect-time about:blank spare(s) recorded at spawn,
    # but only if they are still about:blank (never a tab someone navigated)
    if [[ -f "$SPARES" ]]; then
      LIVE_BLANKS=$(blanks)
      while read -r id; do
        [[ -n "$id" ]] && grep -qx "$id" <<<"$LIVE_BLANKS" \
          && curl -fsS --max-time 3 "http://127.0.0.1:$PORT/json/close/$id" >/dev/null 2>&1
      done < "$SPARES"
      rm -f "$SPARES"
    fi
    exit 0
    ;;
esac

BEFORE=$(front)
ab --pin-tab "$@"
STATUS=$?

# about:blank targets that appeared = this daemon's spare(s)
REAPED=0
reap_spares "$PRE_BLANKS" 1 && REAPED=1

AFTER=$(front)
if [[ -n "$BEFORE" && -n "$AFTER" && "$AFTER" != "$BEFORE" ]]; then
  # Foreground moved during the command. Hand it back only if we are the ones
  # who moved it — either our bound tab is in front, or a spare of ours took
  # the selection and displaced it on close. Never fight a human who switched
  # tabs themselves mid-command.
  MINE=$(ab --pin-tab --json tab list 2>/dev/null \
    | jq -r '.data.tabs[]? | select(.active) | .targetId // empty')
  if [[ "$AFTER" == "$MINE" || "$REAPED" == 1 ]]; then
    restore_front "$BEFORE"
  fi
fi
exit $STATUS
